    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.15" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>
  <ItemGroup Label="Web">
