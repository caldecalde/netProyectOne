{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Aws": {
    "Region": "us-east-1",
    "ResultsBucket": "",
    "EventsTopicArn": ""
  },
  "Mongo": {
    "ConnectionString": "",
    "Database": "careflow_parser"
  },
  "Parser": {
    "SourceBucket": "",
    "MaxFileBytes": 10485760
  },
  "Consumers": {
    "FileReceived": {
      "QueueUrl": "",
      "DeadLetterQueueUrl": "",
      "MaxConcurrency": 4,
      "MaxReceiveCount": 5
    }
  }
}
