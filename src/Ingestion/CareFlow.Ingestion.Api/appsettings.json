{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "",
    "Audience": "careflow-api",
    "RequireHttpsMetadata": true
  },
  "Aws": {
    "Region": "us-east-1",
    "RawBucket": "",
    "EventsTopicArn": ""
  },
  "Mongo": {
    "ConnectionString": "",
    "Database": "careflow_ingestion"
  },
  "Ingestion": {
    "MaxFileBytes": 10485760
  },
  "RateLimiting": {
    "UploadsPerMinute": 30
  }
}
